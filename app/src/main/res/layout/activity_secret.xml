<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/secret_scroll_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ashrama_dark_bg"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/secret_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Classification Banner -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/vault_classification_header"
                android:src="@drawable/ic_archive_lock" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/vault_classification_header"
                android:textColor="@color/vedic_gold"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_vedic_card"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="@string/vault_document_tag"
                android:textColor="@color/parchment_secondary"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Sealed Blob Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_vedic_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vault_sealed_cipher_label"
                android:textColor="@color/parchment_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- The hex blob — plain copyable text, NOT rendered as image/canvas -->
            <TextView
                android:id="@+id/tv_blob"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_input_field"
                android:fontFamily="monospace"
                android:lineSpacingExtra="4dp"
                android:padding="12dp"
                android:textColor="#55FF99"
                android:textIsSelectable="true"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_copy_blob"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginTop="10dp"
                android:layout_gravity="end"
                android:background="@drawable/bg_vedic_button"
                android:paddingHorizontal="14dp"
                android:text="@string/btn_copy_hex"
                android:textColor="@color/ashrama_dark_bg"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Candidate Key Dissolution Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_vedic_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vault_instruction"
                android:textColor="@color/parchment_text"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/et_candidate"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input_field"
                android:fontFamily="monospace"
                android:hint="@string/hint_candidate"
                android:inputType="text"
                android:paddingHorizontal="14dp"
                android:textColor="@color/parchment_text"
                android:textColorHint="@color/parchment_muted"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_submit"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_vedic_button"
                android:text="@string/btn_verify_seal"
                android:textColor="@color/ashrama_dark_bg"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/lore_seal_warning"
            android:textColor="@color/parchment_muted"
            android:textSize="11sp"
            android:lineSpacingExtra="2dp"
            android:layout_marginTop="8dp" />

    </LinearLayout>
</ScrollView>
